# Gemini API Key (Required for backend AI RAG generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional GitHub Token (for higher GitHub REST API rate limits)
GITHUB_TOKEN=your_optional_github_token_here

# PostgreSQL connection string with pgvector support
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# CORS Allowed Origin for Backend
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend backend API endpoint
VITE_API_BASE_URL=http://localhost:8000
